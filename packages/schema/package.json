{
  "name": "@pennyats/schema",
  "version": "1.0.0",
  "private": true,
  "description": "The PennyATS open data format: versioned JSON Schema, workspace export, and import.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "data:export": "tsx scripts/export.ts",
    "data:import": "tsx scripts/import.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@pennyats/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
