{
  "name": "pennyats-monorepo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @pennyats/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @pennyats/db generate",
    "db:migrate": "pnpm --filter @pennyats/db migrate",
    "db:seed": "pnpm --filter @pennyats/db seed",
    "test": "pnpm -r test",
    "test:integration": "node scripts/run-integration.mjs",
    "privacy:purge": "pnpm --filter @pennyats/web privacy:purge",
    "calendar:sync": "pnpm --filter @pennyats/web calendar:sync",
    "scheduling:mail": "pnpm --filter @pennyats/web scheduling:mail",
    "scheduling:integration": "pnpm --filter @pennyats/web scheduling:integration"
  },
  "engines": {
    "node": ">=22"
  }
}
