# Single-container image for one-click hosts (Render, Railway) that run one service next to a
# managed Postgres (#131). On start it migrates the database, then runs the app. For a server
# you manage yourself, use docker-compose.yml with the main Dockerfile instead.
FROM node:22-bookworm-slim

ENV NEXT_TELEMETRY_DISABLED=1 \
    PENNYATS_STANDALONE=1
WORKDIR /app

RUN npm install --global pnpm@10.28.0
COPY . .
RUN pnpm install --frozen-lockfile \
 && pnpm --filter @pennyats/web build \
 && cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static \
 && chown -R node:node /app

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    STORAGE_DIR=/data/uploads
RUN mkdir -p /data/uploads && chown -R node:node /data

# Starts as root only so it can hand the host's volume to the node user, then drops privileges.
EXPOSE 3000
CMD ["sh", "/app/docker/platform-start.sh"]
