# Database: any Postgres connection string (Supabase, Neon, RDS, local Docker)
DATABASE_URL=postgres://pennyats:pennyats@localhost:5432/pennyats

# Docker Compose only: set both values together for a production database.
# If the password contains URL-reserved characters, percent-encode them in
# COMPOSE_DATABASE_URL while leaving POSTGRES_PASSWORD unchanged.
# POSTGRES_PASSWORD=pennyats
# COMPOSE_DATABASE_URL=postgres://pennyats:pennyats@db:5432/pennyats

# Row-level security (docs/rls.md). The app connects as a restricted role that cannot bypass
# it; DATABASE_URL stays the owner that runs migrations. Create the role with
# `pnpm db:app-role` (uses APP_DB_PASSWORD), then point APP_DATABASE_URL at it.
# Docker Compose does both for you. Leave APP_DATABASE_URL empty to skip RLS (development).
# APP_DB_PASSWORD=
# APP_DATABASE_URL=postgres://pennyats_app:CHANGE_ME@localhost:5432/pennyats

# Public base URL of the app. Used in invite links. Use https:// in production
# so the login cookie is marked Secure.
APP_URL=http://localhost:3000

# Required. Encrypts stored secrets (calendar tokens, webhook signing secrets, scheduling
# mail settings). Use a random value of at least 32 characters, for example the output of
#   openssl rand -base64 32
# Keep it stable and backed up: changing it breaks saved calendar connections and webhooks.
# The Docker image refuses to start when it is missing or an example value.
AUTH_SECRET=

# Google Calendar (optional). Configure a Google OAuth web client and add
# APP_URL/api/google-calendar/callback as an authorized redirect URI.
# Each interviewer connects their own calendar from Settings. Refresh tokens
# are encrypted using AUTH_SECRET; keep that secret stable and backed up.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP (optional). Port 465 uses implicit TLS; other ports require STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=interviews@example.com

# Public API: requests a minute allowed per API key (default 300).
# API_RATE_LIMIT_PER_MINUTE=300

# Where uploaded resumes are stored (default: apps/web/.data/uploads). Back this up.
# STORAGE_DIR=/var/lib/pennyats/uploads

# Public demo only (see docs/demo.md). Never set this on a real deployment: it shows a
# "do not enter real data" banner, turns off email, AI, calendar sync, and webhooks,
# and lets `pnpm demo:reset` wipe the database when DEMO_RESET_CONFIRM matches its name.
# DEMO_MODE=true
# DEMO_RESET_HOURS=6
# DEMO_RESET_CONFIRM=pennyats

# AI (optional). Leave blank to run with all AI features off.
# Provider: anthropic | openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional: an OpenAI-compatible server instead of the provider's public API,
# e.g. a local model via Ollama (http://localhost:11434/v1) with AI_PROVIDER=openai.
AI_BASE_URL=
# Redact emails, phones and links before text is sent to a model (recommended)
AI_REDACT_PII=true
