# Database: any Postgres connection string (Supabase, Neon, RDS, local Docker)
DATABASE_URL=postgres://pennyats:pennyats@localhost:5432/pennyats

# Auth: generate with `openssl rand -base64 32`
AUTH_SECRET=change-me

# Public base URL of the app
APP_URL=http://localhost:3000

# AI (optional). Leave blank to run with all AI features off.
# Provider: anthropic | openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Redact emails, phones and links before text is sent to a model (recommended)
AI_REDACT_PII=true
