{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PennyATS/PennyATS/blob/main/docs/schema/v1/note.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "author_email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "description": "A person's email address, lowercase. Listed in `people`."
    },
    "body": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "candidate_id",
    "author_email",
    "body",
    "created_at"
  ],
  "additionalProperties": false,
  "x-pennyats-schema-version": "1.1.0"
}
