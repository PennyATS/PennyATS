{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PennyATS/PennyATS/blob/main/docs/schema/v1/person.schema.json",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "description": "A person's email address, lowercase. Listed in `people`."
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "recruiter",
        "interviewer"
      ]
    }
  },
  "required": [
    "email",
    "name",
    "role"
  ],
  "additionalProperties": false,
  "x-pennyats-schema-version": "1.0.0"
}
